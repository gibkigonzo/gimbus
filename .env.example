# Your user ID from the course hub
USER_ID=
# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Pins the Node process's local time, which the in-process cron scheduler
# (nuxt.config.ts's nitro.scheduledTasks) has no other way to control — see
# server/tasks/agent/scheduled-run.ts for the runtime check against this.
TZ=Europe/Warsaw
